# Development: Vite forwards /api requests to this backend origin.
# Backend CORS_ALLOWED_ORIGINS must include http://localhost:5173.
API_PROXY_TARGET=http://localhost:8080

# Leave empty to use the same origin (and the development proxy).
# For a separately hosted backend, set its public origin before building.
# The backend must then allow the frontend origin in its CORS settings.
VITE_API_BASE_URL=
