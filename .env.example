# Development: Vite forwards /api requests to this backend origin.
# Backend ADMIN_CORS_ALLOWED_ORIGINS must include http://localhost:5173.
# For local HTTP only, set AUTH_COOKIE_SECURE=false in the backend environment.
API_PROXY_TARGET=http://localhost:8080

# Leave empty for first-party admin cookies through the Vite or Netlify /api proxy.
# Netlify's proxy target is configured in netlify.toml.
# Direct cross-site admin requests require additional backend cookie/CORS settings
# and can be blocked by browsers' third-party-cookie policies.
VITE_API_BASE_URL=