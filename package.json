{
  "name": "currency-quiz-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b && vue-tsc -p tsconfig.test.json",
    "test": "vitest run",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run src/api/client.contract.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "bulma": "^1.0.4",
    "swagger-ui": "^5.34.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@types/swagger-ui": "^5.32.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.1.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "swagger-ui": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "@swagger-api/apidom-reference": {
      "minimatch": "^11.0.4"
    },
    "@stryker-mutator/core": {
      "minimatch": "^11.0.4"
    },
    "js-beautify": {
      "glob": "^14.0.3",
      "editorconfig": {
        "minimatch": "^11.0.4"
      }
    },
    "typed-rest-client": {
      "qs": "^6.17.1"
    },
    "typescript": "$typescript"
  }
}
